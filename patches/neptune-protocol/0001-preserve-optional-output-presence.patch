+size_t npt_guest_encode_get_copyable_footprints(uint8_t *buf, size_t size,
+                                                unsigned mask,
+                                                size_t *reply_size)
+{
+    D3D12_RESOURCE_DESC desc;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout;
+    UINT num_rows;
+    UINT64 row_size;
+    UINT64 total_bytes;
+    memset(&desc, 0, sizeof(desc));
+    memset(&layout, 0, sizeof(layout));
+    *reply_size = npt_sizeof_ID3D12Device_GetCopyableFootprints_reply(
+        &desc, 0, 1, 0,
+        (mask & 1) ? &layout : NULL,
+        (mask & 2) ? &num_rows : NULL,
+        (mask & 4) ? &row_size : NULL,
+        (mask & 8) ? &total_bytes : NULL);
+
+    struct npt_cs_encoder enc = npt_test_encoder_init(buf, size);
+    npt_encode_ID3D12Device_GetCopyableFootprints(
+        &enc, NPT_CMD_FLAG_REPLY, 0xDEAD, &desc, 0, 1, 0,
+        (mask & 1) ? &layout : NULL,
+        (mask & 2) ? &num_rows : NULL,
+        (mask & 4) ? &row_size : NULL,
+        (mask & 8) ? &total_bytes : NULL);
+    return npt_test_encoder_written(&enc, buf);
+}
+
+int npt_guest_decode_get_copyable_footprints_reply(const uint8_t *buf,
+                                                    size_t size,
+                                                    unsigned mask)
+{
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout;
+    UINT num_rows = 0;
+    UINT64 row_size = 0;
+    UINT64 total_bytes = 0;
+    memset(&layout, 0, sizeof(layout));
+    struct npt_cs_decoder dec = npt_test_decoder_init(buf, size);
+    npt_decode_ID3D12Device_GetCopyableFootprints_reply(
+        &dec,
+        (mask & 1) ? &layout : NULL,
+        (mask & 2) ? &num_rows : NULL,
+        (mask & 4) ? &row_size : NULL,
+        (mask & 8) ? &total_bytes : NULL);
+    int result = dec.fatal || dec.cur != dec.end;
+    result |= (mask & 1) && layout.Offset != 64;
+    result |= (mask & 2) && num_rows != 7;
+    result |= (mask & 4) && row_size != 512;
+    result |= (mask & 8) && total_bytes != 4096;
+    npt_test_cleanup(&dec);
+    return result ? -1 : 0;
+}
