+extern size_t npt_guest_encode_get_copyable_footprints(
+    uint8_t *buf, size_t size, unsigned mask, size_t *reply_size);
+extern int npt_guest_decode_get_copyable_footprints_reply(
+    const uint8_t *buf, size_t size, unsigned mask);
+
+static int test_manual_get_copyable_footprints_optional_outputs(void)
+{
+    static const unsigned masks[] = {
+        15, /* all outputs */
+        9,  /* pLayouts + pTotalBytes */
+        10, /* pNumRows + pTotalBytes */
+        12, /* pRowSizeInBytes + pTotalBytes */
+        0,  /* all optional outputs absent */
+    };
+
+    for (size_t i = 0; i < sizeof(masks) / sizeof(masks[0]); i++) {
+        const unsigned mask = masks[i];
+        uint8_t cmd[256] = {0};
+        size_t reserved = 0;
+        size_t cmd_size = npt_guest_encode_get_copyable_footprints(
+            cmd, sizeof(cmd), mask, &reserved);
+        struct npt_cs_decoder dec = npt_test_decoder_init(
+            cmd + sizeof(struct npt_command_header),
+            cmd_size - sizeof(struct npt_command_header));
+        struct npt_command_ID3D12Device_GetCopyableFootprints args = {0};
+        npt_decode_ID3D12Device_GetCopyableFootprints_args_temp(&dec, &args);
+
+        if (dec.fatal || dec.cur != dec.end ||
+            (!!args.pLayouts != !!(mask & 1)) ||
+            (!!args.pNumRows != !!(mask & 2)) ||
+            (!!args.pRowSizeInBytes != !!(mask & 4)) ||
+            (!!args.pTotalBytes != !!(mask & 8))) {
+            fprintf(stderr, "FAIL: GetCopyableFootprints presence mask 0x%x\n",
+                    mask);
+            npt_test_cleanup(&dec);
+            return -1;
+        }
+
+        if (args.pLayouts) args.pLayouts[0].Offset = 64;
+        if (args.pNumRows) args.pNumRows[0] = 7;
+        if (args.pRowSizeInBytes) args.pRowSizeInBytes[0] = 512;
+        if (args.pTotalBytes) *args.pTotalBytes = 4096;
+
+        uint8_t *reply = calloc(1, reserved ? reserved : 1);
+        struct npt_cs_encoder enc = npt_test_encoder_init(reply, reserved);
+        npt_encode_ID3D12Device_GetCopyableFootprints_reply(&enc, &args);
+        size_t actual = npt_test_encoder_written(&enc, reply);
+        if (actual != reserved ||
+            npt_guest_decode_get_copyable_footprints_reply(reply, actual, mask)) {
+            fprintf(stderr, "FAIL: GetCopyableFootprints mask 0x%x: "
+                    "guest reserved %zu, host encoded %zu\n",
+                    mask, reserved, actual);
+            free(reply);
+            npt_test_cleanup(&dec);
+            return -1;
+        }
+        free(reply);
+        npt_test_cleanup(&dec);
+    }
+    return 0;
+}
