     return 0;
 }
 
+static int test_manual_get_private_data_required_size(void)
+{
+    uint8_t reply[64] = {0};
+    UINT required_size = 256;
+    uint8_t original_buffer[1] = {0xa5};
+    struct npt_command_ID3D12Object_GetPrivateData args = {
+        .pDataSize = &required_size,
+        .pData = original_buffer,
+        .ret = (HRESULT)0x887a0003, /* DXGI_ERROR_MORE_DATA */
+    };
+    struct npt_cs_encoder enc = npt_test_encoder_init(reply, sizeof(reply));
+
+    npt_encode_ID3D12Object_GetPrivateData_reply(&enc, &args);
+
+    const size_t reply_size = npt_test_encoder_written(&enc, reply);
+    struct npt_cs_decoder dec = npt_test_decoder_init(
+        reply + sizeof(struct npt_reply_header),
+        reply_size - sizeof(struct npt_reply_header));
+    UINT decoded_size = 0;
+
+    if (!npt_decode_simple_pointer(&dec)) {
+        fprintf(stderr, "FAIL: GetPrivateData omitted pDataSize\n");
+        return -1;
+    }
+    npt_decode_UINT(&dec, &decoded_size);
+    const uint64_t data_size = npt_decode_array_count_unchecked(&dec);
+
+    if (dec.fatal || dec.cur != dec.end || decoded_size != required_size ||
+        data_size != 0) {
+        fprintf(stderr, "FAIL: GetPrivateData failure reply: required %u, "
+                "data count %" PRIu64 "\n", decoded_size, data_size);
+        return -1;
+    }
+    return 0;
+}
+
