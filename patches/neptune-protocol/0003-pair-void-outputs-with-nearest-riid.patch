diff --git a/tests/test_riid_pairing.py b/tests/test_riid_pairing.py
new file mode 100644
index 0000000..3e21cf0
--- /dev/null
+++ b/tests/test_riid_pairing.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+
+# Copyright 2026 Turing Software LLC
+# SPDX-License-Identifier: Apache-2.0
+
+"""Check which REFIID input names each void ** output's interface."""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'tools'))
+
+from npt_registry import TypeRegistry, void_output_riids
+
+
+def pairs(registry, iface_name, method_name):
+    for iface in registry.interfaces:
+        if iface.name != iface_name:
+            continue
+        for m in iface.methods:
+            if m.name == method_name:
+                return {out: p.name
+                        for out, p in void_output_riids(m.params).items()}
+    raise KeyError(f'{iface_name}::{method_name}')
+
+
+def main():
+    json_path, overlay_path, ids_path = sys.argv[1:4]
+    registry = TypeRegistry()
+    registry.load(json_path, [overlay_path], interface_ids_path=ids_path)
+    registry.resolve()
+
+    expected = {
+        # CreatorID is a GUID input before riid; it names no interface.
+        ('ID3D12Device9', 'CreateCommandQueue1'):
+            {'ppCommandQueue': 'riid'},
+        ('ID3D12SwapChainAssistant', 'GetCurrentResourceAndCommandQueue'):
+            {'ppvResource': 'riidResource', 'ppvQueue': 'riidQueue'},
+        ('ID3D12Device', 'CreateCommittedResource'):
+            {'ppvResource': 'riidResource'},
+    }
+    failed = 0
+    for (iface_name, method_name), want in expected.items():
+        got = pairs(registry, iface_name, method_name)
+        if got != want:
+            print(f'FAIL: {iface_name}::{method_name}: {got} != {want}')
+            failed += 1
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
