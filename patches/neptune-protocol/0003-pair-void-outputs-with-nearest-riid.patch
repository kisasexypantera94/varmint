diff --git a/tools/npt_registry.py b/tools/npt_registry.py
index 4abb5c1..adef8c9 100644
--- a/tools/npt_registry.py
+++ b/tools/npt_registry.py
@@ -543,6 +543,22 @@ def canonical_default(method_name):
     return not method_name.startswith(('Create', 'Open'))


+def void_output_riids(params):
+    """Map each void ** output parameter's name to the REFIID input that
+    names its interface: the nearest IID input before it.  Position alone
+    is wrong when another GUID input comes first, as in
+    CreateCommandQueue1(pDesc, CreatorID, riid, ppCommandQueue)."""
+    pairs = {}
+    riid = None
+    for p in params:
+        if p.input and not p.output and p.type_name == 'IID':
+            riid = p
+        elif (p.output and p.is_com_handle
+              and p.type_name in ('void', 'VOID') and riid is not None):
+            pairs[p.name] = riid
+    return pairs
+
+
