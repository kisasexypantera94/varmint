+bool
+DynamicBuffer::bindInitialExternal(Rc<BufferAllocation> &&allocation) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+
+  if (external_mode_ || !allocation.ptr() || !fifo.empty() ||
+      owned_by_command_list_ || name_.ptr() != buffer->current())
+    return false;
+
+  auto old = buffer->rename(Rc<BufferAllocation>(allocation));
+  name_ = std::move(allocation);
+  name_suballocation_ = 0;
+  external_mode_ = true;
+  return true;
+}
