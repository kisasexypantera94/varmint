+extern "C" int32_t
+dxmt_d3d11_buffer_bind_external_fd(void *d3d11_buffer, int fd,
+                                   uint64_t backing_length,
+                                   uint32_t cookie, uint32_t flags) {
+  auto *resource = dxmt_native_resource(d3d11_buffer);
+  if (!resource)
