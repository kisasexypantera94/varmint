diff --git a/src/virtio/neptune/npt_shared_texture.c b/src/virtio/neptune/npt_shared_texture.c
--- a/src/virtio/neptune/npt_shared_texture.c
+++ b/src/virtio/neptune/npt_shared_texture.c
@@ -94,6 +94,11 @@ uint32_t
 npt_shared_texture_host_format(uint32_t dxgi_format)
 {
    switch (dxgi_format) {
+   case DXGI_FORMAT_R10G10B10A2_UNORM:
+      /* Keep the app backbuffer R10, but export the X11/DRI3 present pool as
+       * BGRA8.  The host D3D backend converts R10 -> BGRA8 on the present
+       * CopyResource path. */
+      return DXGI_FORMAT_B8G8R8A8_UNORM;
    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
       return DXGI_FORMAT_R8G8B8A8_UNORM;
