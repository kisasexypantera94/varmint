+/*
+ * Formats that the current DXMT backend cannot turn into a Metal texture.
+ *
+ * Keep this in sync with the E_FAIL cases in DXMT's dxmt_format.cpp.
+ * CheckFormatSupport is still used for every other format, but currently
+ * reports non-zero support for at least some of these even though actual
+ * texture creation fails.
+ */
+static bool
+dev_texture_format_host_creatable(DXGI_FORMAT format)
+{
+   switch (format) {
+   case DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM:
+   case DXGI_FORMAT_AYUV:
+   case DXGI_FORMAT_Y410:
+   case DXGI_FORMAT_Y416:
+   case DXGI_FORMAT_NV12:
+   case DXGI_FORMAT_P010:
+   case DXGI_FORMAT_P016:
+   case DXGI_FORMAT_420_OPAQUE:
+   case DXGI_FORMAT_YUY2:
+   case DXGI_FORMAT_Y210:
+   case DXGI_FORMAT_Y216:
+   case DXGI_FORMAT_NV11:
+   case DXGI_FORMAT_AI44:
+   case DXGI_FORMAT_IA44:
+   case DXGI_FORMAT_P8:
+   case DXGI_FORMAT_A8P8:
+   case DXGI_FORMAT_P208:
+   case DXGI_FORMAT_V208:
+   case DXGI_FORMAT_V408:
+   case DXGI_FORMAT_FORCE_UINT:
+      return false;
+   default:
+      return true;
+   }
+}
+
+
+static bool
+dev_texture_format_supported(void *self, DXGI_FORMAT format)
+{
+   if (format == DXGI_FORMAT_UNKNOWN)
+      return true;
+
+   struct npt_d3d11_device_aux *aux = dev_aux(self);
+   const unsigned idx = (unsigned)format;
+
+   /* The host's current CheckFormatSupport answer is not sufficient for
+    * these formats: DXMT's format conversion rejects them during actual
+    * texture creation. */
+   if (!dev_texture_format_host_creatable(format)) {
+      bool first = true;
+
+      if (aux && idx < sizeof(aux->format_support)) {
+         mtx_lock(&aux->cache_mutex);
+         first = aux->format_support[idx] == 0;
+         aux->format_support[idx] = 2;
+         mtx_unlock(&aux->cache_mutex);
+      }
+
+      if (first)
+         npt_log("CreateTexture: format %u cannot be created by host; refused",
+                 idx);
+
+      return false;
+   }
+
+   if (aux && idx < sizeof(aux->format_support)) {
+      mtx_lock(&aux->cache_mutex);
+      const uint8_t cached = aux->format_support[idx];
+      mtx_unlock(&aux->cache_mutex);
+
+      if (cached)
+         return cached == 1;
+   }
+
+   UINT support = 0;
+   const HRESULT hr =
+      npt_id3d11device_default_CheckFormatSupport(self, format, &support);
+
+   /*
+    * A query/transport failure is not evidence that the format itself is
+    * unsupported.  Preserve the old behaviour and let Create decide.
+    */
+   if (NPT_FAILED(hr))
+      return true;
+
+   const bool supported = support != 0;
+
+   if (aux && idx < sizeof(aux->format_support)) {
+      mtx_lock(&aux->cache_mutex);
+      aux->format_support[idx] = supported ? 1 : 2;
+      mtx_unlock(&aux->cache_mutex);
+   }
+
+   if (!supported)
+      npt_log("CreateTexture: format %u has no host support; refused", idx);
+
+   return supported;
+}
+
+
+static HRESULT
+dev_refuse_unsupported_texture(void *self, DXGI_FORMAT format,
+                               void **out_resource)
+{
+   if (dev_texture_format_supported(self, format))
+      return NPT_S_OK;
+
+   if (out_resource)
+      *out_resource = NULL;
+
+   /* Match Triton's behaviour for a texture format the host cannot make. */
+   return NPT_E_OUTOFMEMORY;
+}
