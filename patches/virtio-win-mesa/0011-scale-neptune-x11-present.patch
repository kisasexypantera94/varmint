+static xcb_render_pictformat_t
+find_rgb24_format(xcb_connection_t *conn)
+{
+   xcb_render_query_pict_formats_reply_t *reply =
+      xcb_render_query_pict_formats_reply(
+         conn, xcb_render_query_pict_formats(conn), NULL);
+   if (!reply)
+      return XCB_NONE;
+
+   xcb_render_pictformat_t result = XCB_NONE;
+   for (xcb_render_pictforminfo_iterator_t it =
+           xcb_render_query_pict_formats_formats_iterator(reply);
+        it.rem;
+        xcb_render_pictforminfo_next(&it)) {
+      const xcb_render_pictforminfo_t *f = it.data;
+
+      if (f->type == XCB_RENDER_PICT_TYPE_DIRECT &&
+          f->depth == 24 &&
+          f->direct.red_shift == 16 &&
+          f->direct.red_mask == 0xff &&
+          f->direct.green_shift == 8 &&
+          f->direct.green_mask == 0xff &&
+          f->direct.blue_shift == 0 &&
+          f->direct.blue_mask == 0xff &&
+          f->direct.alpha_mask == 0) {
+         result = f->id;
+         break;
+      }
+   }
+
+   free(reply);
+   return result;
+}
+
+static void
+destroy_scaled_target(struct npt_unix_wsi *w, uint32_t i)
+{
+   typeof(w->images[0]) *img = &w->images[i];
+
+   if (img->scaled_picture != XCB_NONE) {
+      xcb_render_free_picture(w->conn, img->scaled_picture);
+      img->scaled_picture = XCB_NONE;
+   }
+
+   if (img->scaled_pixmap != XCB_NONE) {
+      xcb_free_pixmap(w->conn, img->scaled_pixmap);
+      img->scaled_pixmap = XCB_NONE;
+   }
+
+   img->scaled_width = 0;
+   img->scaled_height = 0;
+}
+
+static bool
+create_scaled_image(struct npt_unix_wsi *w, uint32_t i)
+{
+   typeof(w->images[0]) *img = &w->images[i];
+
+   if (w->rgb24_format == XCB_NONE) {
+      w->rgb24_format = find_rgb24_format(w->conn);
+      if (w->rgb24_format == XCB_NONE) {
+         fprintf(stderr,
+                 "neptune unixlib wsi: no RGB24 XRender format\n");
+         return false;
+      }
+   }
+
+   if (img->src_picture == XCB_NONE) {
+      img->src_picture = xcb_generate_id(w->conn);
+      xcb_void_cookie_t ck = xcb_render_create_picture_checked(
+         w->conn, img->src_picture, img->pixmap,
+         w->rgb24_format, 0, NULL);
+      xcb_generic_error_t *err = xcb_request_check(w->conn, ck);
+      if (err) {
+         fprintf(stderr,
+                 "neptune unixlib wsi: create source Render picture failed (%u)\n",
+                 err->error_code);
+         free(err);
+         img->src_picture = XCB_NONE;
+         return false;
+      }
+   }
+
+   img->scaled_pixmap = xcb_generate_id(w->conn);
+   xcb_void_cookie_t ck = xcb_create_pixmap_checked(
+      w->conn, 24, img->scaled_pixmap, w->window,
+      w->target_width, w->target_height);
+   xcb_generic_error_t *err = xcb_request_check(w->conn, ck);
+   if (err) {
+      fprintf(stderr,
+              "neptune unixlib wsi: create scaled pixmap failed (%u)\n",
+              err->error_code);
+      free(err);
+      img->scaled_pixmap = XCB_NONE;
+      return false;
+   }
+
+   img->scaled_picture = xcb_generate_id(w->conn);
+   ck = xcb_render_create_picture_checked(
+      w->conn, img->scaled_picture, img->scaled_pixmap,
+      w->rgb24_format, 0, NULL);
+   err = xcb_request_check(w->conn, ck);
+   if (err) {
+      fprintf(stderr,
+              "neptune unixlib wsi: create scaled Render picture failed (%u)\n",
+              err->error_code);
+      free(err);
+      img->scaled_picture = XCB_NONE;
+      xcb_free_pixmap(w->conn, img->scaled_pixmap);
+      img->scaled_pixmap = XCB_NONE;
+      return false;
+   }
+
+   img->scaled_width = w->target_width;
+   img->scaled_height = w->target_height;
+   return true;
+}
+
+static void
+drain_window_events(struct npt_unix_wsi *w)
+{
+   xcb_generic_event_t *ev;
+
+   while ((ev = xcb_poll_for_event(w->conn))) {
+      const uint8_t type = ev->response_type & 0x7f;
+
+      if (type == XCB_CONFIGURE_NOTIFY) {
+         const xcb_configure_notify_event_t *configure =
+            (const xcb_configure_notify_event_t *)ev;
+
+         if (configure->window == w->window &&
+             configure->width && configure->height &&
+             (configure->width != w->target_width ||
+              configure->height != w->target_height)) {
+            const uint32_t old_width = w->target_width;
+            const uint32_t old_height = w->target_height;
+
+            w->target_width = configure->width;
+            w->target_height = configure->height;
+            w->scale =
+               w->target_width != w->width ||
+               w->target_height != w->height;
+
+            fprintf(stderr,
+                    "neptune unixlib wsi: target resize %ux%u -> %ux%u "
+                    "(source=%ux%u, scale=%d)\n",
+                    old_width, old_height,
+                    w->target_width, w->target_height,
+                    w->width, w->height,
+                    (int)w->scale);
+         }
+      }
+
+      free(ev);
+   }
+}
+
+static void
+wait_for_source_fence(struct npt_unix_wsi_present_params *p)
+{
+   if (p->wait_fence_fd < 0)
+      return;
+
+   struct pollfd pfd = {
+      .fd = p->wait_fence_fd,
+      .events = POLLIN,
+   };
+
+   int rc;
+   do {
+      rc = poll(&pfd, 1, 30000);
+   } while (rc < 0 && errno == EINTR);
+
+   close(p->wait_fence_fd);
+   p->wait_fence_consumed = 1;
+}
+
+static void
+scale_image(struct npt_unix_wsi *w, uint32_t i)
+{
+   typeof(w->images[0]) *img = &w->images[i];
+
+   uint32_t view_w = w->target_width;
+   uint32_t view_h =
+      (uint32_t)(((uint64_t)w->height * view_w) / w->width);
+
+   if (view_h > w->target_height) {
+      view_h = w->target_height;
+      view_w =
+         (uint32_t)(((uint64_t)w->width * view_h) / w->height);
+   }
+
+   if (!view_w) view_w = 1;
+   if (!view_h) view_h = 1;
+
+   const int16_t dst_x =
+      (int16_t)((w->target_width - view_w) / 2);
+   const int16_t dst_y =
+      (int16_t)((w->target_height - view_h) / 2);
+
+   xcb_rectangle_t bars[2];
+   uint32_t num_bars = 0;
+
+   if (dst_y > 0) {
+      bars[num_bars++] = (xcb_rectangle_t) {
+         .x = 0,
+         .y = 0,
+         .width = (uint16_t)w->target_width,
+         .height = (uint16_t)dst_y,
+      };
+      bars[num_bars++] = (xcb_rectangle_t) {
+         .x = 0,
+         .y = (int16_t)(dst_y + view_h),
+         .width = (uint16_t)w->target_width,
+         .height = (uint16_t)(w->target_height - dst_y - view_h),
+      };
+   } else if (dst_x > 0) {
+      bars[num_bars++] = (xcb_rectangle_t) {
+         .x = 0,
+         .y = 0,
+         .width = (uint16_t)dst_x,
+         .height = (uint16_t)w->target_height,
+      };
+      bars[num_bars++] = (xcb_rectangle_t) {
+         .x = (int16_t)(dst_x + view_w),
+         .y = 0,
+         .width = (uint16_t)(w->target_width - dst_x - view_w),
+         .height = (uint16_t)w->target_height,
+      };
+   }
+
+   if (num_bars) {
+      const xcb_render_color_t black = {
+         .red = 0,
+         .green = 0,
+         .blue = 0,
+         .alpha = 0xffff,
+      };
+
+      xcb_render_fill_rectangles(
+         w->conn,
+         XCB_RENDER_PICT_OP_SRC,
+         img->scaled_picture,
+         black,
+         num_bars,
+         bars);
+   }
+
+   xcb_render_transform_t transform = {
+      .matrix11 =
+         (xcb_render_fixed_t)(((uint64_t)w->width << 16) / view_w),
+      .matrix12 = 0,
+      .matrix13 = 0,
+      .matrix21 = 0,
+      .matrix22 =
+         (xcb_render_fixed_t)(((uint64_t)w->height << 16) / view_h),
+      .matrix23 = 0,
+      .matrix31 = 0,
+      .matrix32 = 0,
+      .matrix33 = 1 << 16,
+   };
+
+   xcb_render_set_picture_transform(
+      w->conn, img->src_picture, transform);
+
+   static const char filter[] = "bilinear";
+   xcb_render_set_picture_filter(
+      w->conn, img->src_picture,
+      sizeof(filter) - 1, filter,
+      0, NULL);
+
+   xcb_render_composite(
+      w->conn,
+      XCB_RENDER_PICT_OP_SRC,
+      img->src_picture,
+      XCB_NONE,
+      img->scaled_picture,
+      0, 0,
+      0, 0,
+      dst_x, dst_y,
+      (uint16_t)view_w,
+      (uint16_t)view_h);
+}
