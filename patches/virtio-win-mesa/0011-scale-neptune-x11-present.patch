+static xcb_render_pictformat_t
+find_rgb24_format(xcb_connection_t *conn)
+{
+   xcb_render_query_pict_formats_reply_t *reply =
+      xcb_render_query_pict_formats_reply(
+         conn, xcb_render_query_pict_formats(conn), NULL);
+   if (!reply)
+      return XCB_NONE;
+
+   xcb_render_pictformat_t result = XCB_NONE;
+   for (xcb_render_pictforminfo_iterator_t it =
+           xcb_render_query_pict_formats_formats_iterator(reply);
+        it.rem;
+        xcb_render_pictforminfo_next(&it)) {
+      const xcb_render_pictforminfo_t *f = it.data;
+
+      if (f->type == XCB_RENDER_PICT_TYPE_DIRECT &&
+          f->depth == 24 &&
+          f->direct.red_shift == 16 &&
+          f->direct.red_mask == 0xff &&
+          f->direct.green_shift == 8 &&
+          f->direct.green_mask == 0xff &&
+          f->direct.blue_shift == 0 &&
+          f->direct.blue_mask == 0xff &&
+          f->direct.alpha_mask == 0) {
+         result = f->id;
+         break;
+      }
+   }
+
+   free(reply);
+   return result;
+}
+
+static bool
+create_scaled_image(uint32_t i)
+{
+   typeof(g_wsi.images[0]) *img = &g_wsi.images[i];
+
+   img->src_picture = xcb_generate_id(g_wsi.conn);
+   xcb_void_cookie_t ck = xcb_render_create_picture_checked(
+      g_wsi.conn, img->src_picture, img->pixmap,
+      g_wsi.rgb24_format, 0, NULL);
+   xcb_generic_error_t *err = xcb_request_check(g_wsi.conn, ck);
+   if (err) {
+      fprintf(stderr,
+              "neptune unixlib wsi: create source Render picture failed (%u)\n",
+              err->error_code);
+      free(err);
+      img->src_picture = XCB_NONE;
+      return false;
+   }
+
+   img->scaled_pixmap = xcb_generate_id(g_wsi.conn);
+   ck = xcb_create_pixmap_checked(
+      g_wsi.conn, 24, img->scaled_pixmap, g_wsi.window,
+      g_wsi.target_width, g_wsi.target_height);
+   err = xcb_request_check(g_wsi.conn, ck);
+   if (err) {
+      fprintf(stderr,
+              "neptune unixlib wsi: create scaled pixmap failed (%u)\n",
+              err->error_code);
+      free(err);
+      img->scaled_pixmap = XCB_NONE;
+      return false;
+   }
+
+   img->scaled_picture = xcb_generate_id(g_wsi.conn);
+   ck = xcb_render_create_picture_checked(
+      g_wsi.conn, img->scaled_picture, img->scaled_pixmap,
+      g_wsi.rgb24_format, 0, NULL);
+   err = xcb_request_check(g_wsi.conn, ck);
+   if (err) {
+      fprintf(stderr,
+              "neptune unixlib wsi: create scaled Render picture failed (%u)\n",
+              err->error_code);
+      free(err);
+      img->scaled_picture = XCB_NONE;
+      return false;
+   }
+
+   return true;
+}
+
+static void
+wait_for_source_fence(struct npt_unix_wsi_present_params *p)
+{
+   if (p->wait_fence_fd < 0)
+      return;
+
+   struct pollfd pfd = {
+      .fd = p->wait_fence_fd,
+      .events = POLLIN,
+   };
+
+   int rc;
+   do {
+      rc = poll(&pfd, 1, 30000);
+   } while (rc < 0 && errno == EINTR);
+
+   close(p->wait_fence_fd);
+   p->wait_fence_consumed = 1;
+}
+
+static void
+scale_image(uint32_t i)
+{
+   typeof(g_wsi.images[0]) *img = &g_wsi.images[i];
+
+   uint32_t view_w = g_wsi.target_width;
+   uint32_t view_h =
+      (uint32_t)(((uint64_t)g_wsi.height * view_w) / g_wsi.width);
+
+   if (view_h > g_wsi.target_height) {
+      view_h = g_wsi.target_height;
+      view_w =
+         (uint32_t)(((uint64_t)g_wsi.width * view_h) / g_wsi.height);
+   }
+
+   if (!view_w) view_w = 1;
+   if (!view_h) view_h = 1;
+
+   const int16_t dst_x =
+      (int16_t)((g_wsi.target_width - view_w) / 2);
+   const int16_t dst_y =
+      (int16_t)((g_wsi.target_height - view_h) / 2);
+
+   const xcb_render_color_t black = {
+      .red = 0,
+      .green = 0,
+      .blue = 0,
+      .alpha = 0xffff,
+   };
+   const xcb_rectangle_t full = {
+      .x = 0,
+      .y = 0,
+      .width = (uint16_t)g_wsi.target_width,
+      .height = (uint16_t)g_wsi.target_height,
+   };
+
+   xcb_render_fill_rectangles(
+      g_wsi.conn,
+      XCB_RENDER_PICT_OP_SRC,
+      img->scaled_picture,
+      black,
+      1,
+      &full);
+
+   xcb_render_transform_t transform = {
+      .matrix11 =
+         (xcb_render_fixed_t)(((uint64_t)g_wsi.width << 16) / view_w),
+      .matrix12 = 0,
+      .matrix13 = 0,
+      .matrix21 = 0,
+      .matrix22 =
+         (xcb_render_fixed_t)(((uint64_t)g_wsi.height << 16) / view_h),
+      .matrix23 = 0,
+      .matrix31 = 0,
+      .matrix32 = 0,
+      .matrix33 = 1 << 16,
+   };
+
+   xcb_render_set_picture_transform(
+      g_wsi.conn, img->src_picture, transform);
+
+   static const char filter[] = "bilinear";
+   xcb_render_set_picture_filter(
+      g_wsi.conn, img->src_picture,
+      sizeof(filter) - 1, filter,
+      0, NULL);
+
+   xcb_render_composite(
+      g_wsi.conn,
+      XCB_RENDER_PICT_OP_SRC,
+      img->src_picture,
+      XCB_NONE,
+      img->scaled_picture,
+      0, 0,
+      0, 0,
+      dst_x, dst_y,
+      (uint16_t)view_w,
+      (uint16_t)view_h);
+}
