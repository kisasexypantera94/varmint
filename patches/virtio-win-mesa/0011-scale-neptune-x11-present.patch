diff --git a/src/virtio/neptune/npt_swapchain.c b/src/virtio/neptune/npt_swapchain.c
index a5cc7f68c12..5663d3a1979 100644
--- a/src/virtio/neptune/npt_swapchain.c
+++ b/src/virtio/neptune/npt_swapchain.c
@@ -900,17 +900,33 @@ static HRESULT NPT_STDMETHODCALLTYPE
 gsc_SetFullscreenState(void *self, BOOL Fullscreen, IDXGIOutput *pTarget)
 {
    struct npt_guest_swapchain *s = gsc(self);
+   struct npt_guest_swapchain_common *c = &s->base;

    if (!Fullscreen && pTarget)
       return NPT_DXGI_ERROR_INVALID_CALL;

+   /*
+    * Serialize the HWND geometry change with Present/Resize.  The WSI caches
+    * the target window geometry at init, so a real fullscreen transition
+    * invalidates it even when the application does not call ResizeBuffers.
+    */
+   mtx_lock(&c->present_mutex);
+   const BOOL was_fullscreen = c->fullscreen;
+
+   HRESULT hr = NPT_S_OK;
+
    /* Dispatch the windowed <-> fullscreen transition; both directions place
     * and style the app's own OutputWindow guest-side. */
-   if (!s->base.fullscreen && Fullscreen)
-      return gsc_enter_fullscreen(self, s, pTarget);
-   if (s->base.fullscreen && !Fullscreen)
-      return gsc_leave_fullscreen(self, s);
-   return NPT_S_OK;
+   if (!c->fullscreen && Fullscreen)
+      hr = gsc_enter_fullscreen(self, s, pTarget);
+   else if (c->fullscreen && !Fullscreen)
+      hr = gsc_leave_fullscreen(self, s);
+
+   if (c->fullscreen != was_fullscreen)
+      gsc_teardown_wsi(s, false);
+
+   mtx_unlock(&c->present_mutex);
+   return hr;
 }

