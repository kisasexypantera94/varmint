+/* The create is sent without waiting and reported as successful; a host
+ * failure would leave the app using a pipeline that does not exist.  An
+ * empty CS is invalid input, so refuse it here, synchronously. */
+static HRESULT NPT_STDMETHODCALLTYPE
+dev12_CreateComputePipelineState_override(
+   void *self, const D3D12_COMPUTE_PIPELINE_STATE_DESC *pDesc,
+   const IID *riid, void **ppPipelineState)
+{
+   if (pDesc && (!pDesc->CS.pShaderBytecode || !pDesc->CS.BytecodeLength)) {
+      if (ppPipelineState)
+         *ppPipelineState = NULL;
+      return NPT_E_INVALIDARG;
+   }
+   return npt_id3d12device_default_CreateComputePipelineState(
+      self, pDesc, riid, ppPipelineState);
+}
+
 /* ==========================================================================
  * Shmem-backed CPU-visible heaps (persistent-map path)
