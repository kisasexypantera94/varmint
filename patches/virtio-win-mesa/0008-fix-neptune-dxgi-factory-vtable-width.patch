+void
+npt_com_replace_ctor(const GUID *iid, npt_com_ctor_fn ctor)
+{
+   if (!iid || !ctor)
+      return;
+
+   struct npt_com_ctor_entry *e = npt_com_table_lookup_entry_mut(iid);
+   if (!e || e->iid == NULL) {
+      npt_log("npt_com_replace_ctor: no default ctor registered for IID");
+      return;
+   }
+
+   e->ctor = ctor;
+}
