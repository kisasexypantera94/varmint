+static HRESULT NPT_STDMETHODCALLTYPE
+gsc12_SetFullscreenState(void *self, BOOL Fullscreen, IDXGIOutput *pTarget)
+{
+   struct npt_guest_swapchain12 *s = gsc12(self);
+   struct npt_guest_swapchain_common *c = &s->base;
+
+   if (!Fullscreen && pTarget)
+      return NPT_DXGI_ERROR_INVALID_CALL;
+
+   mtx_lock(&c->present_mutex);
+   const BOOL was_fullscreen = c->fullscreen;
+
+   HRESULT hr = NPT_S_OK;
+   if (!c->fullscreen && Fullscreen) {
+      IDXGIOutput *first = pTarget ? NULL : gsc12_resolve_first_output(s);
+      hr = npt_gsc_enter_fullscreen(c, pTarget ? pTarget : first);
+      if (first)
+         npt_gsc_output_vtbl(first)->Release(first);
+   } else if (c->fullscreen && !Fullscreen) {
+      hr = npt_gsc_leave_fullscreen(c);
+   }
+
+   if (c->fullscreen != was_fullscreen) {
+      /* The copy lists may still be executing on the host GPU. */
+      if (c->wsi_initialized)
+         gsc12_gpu_drain(s);
+      gsc12_teardown_wsi(s, false);
+   }
+
+   mtx_unlock(&c->present_mutex);
+   return hr;
+}
