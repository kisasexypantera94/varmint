+/* Neptune cannot return meta-command descriptors, so it exposes none and
+ * answers as the D3D12 runtime does for a driver without them.  Failing
+ * instead breaks callers that treat the error as fatal (DirectStorage). */
+static HRESULT NPT_STDMETHODCALLTYPE
+dev12_EnumerateMetaCommands_override(void *self, UINT *pNumMetaCommands,
+                                     D3D12_META_COMMAND_DESC *pDescs)
+{
+   (void)self;
+   (void)pDescs;
+   if (!pNumMetaCommands)
+      return NPT_E_INVALIDARG;
+   *pNumMetaCommands = 0;
+   return NPT_S_OK;
+}
