+   HRESULT hr = npt_dispatch_bind_d3d11_buffer_shmem(
+      ring, aux->com->base.id, shmem->res_id, aux->byte_width,
+      cookie, flags);
+   if (NPT_FAILED(hr)) {
+      npt_renderer_shmem_unref(renderer, shmem);
+      return false;
+   }
+
+   aux->external_slots[aux->external_count++] = shmem;
+   if (flags & NPT_D3D11_EXTERNAL_BIND_INITIAL)
+      aux->external_enabled = true;
+   return true;
+}
