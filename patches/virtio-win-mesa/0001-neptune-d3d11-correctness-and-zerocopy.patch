+static bool
+npt_d3d11_buffer_add_external_slot_(struct npt_d3d11_buffer *b,
+                                    struct npt_ring *ring,
+                                    uint32_t flags)
+{
+   struct npt_d3d11_buffer_aux *aux = buf_aux(b);
+   if (!aux || !aux->byte_width || !ring ||
+       (flags & NPT_D3D11_EXTERNAL_BIND_INITIAL && aux->external_enabled) ||
+       (!(flags & NPT_D3D11_EXTERNAL_BIND_INITIAL) && !aux->external_enabled))
+      return false;
+
+   if (aux->external_count == aux->external_cap) {
+      uint32_t cap = aux->external_cap ? aux->external_cap * 2u : 4u;
+      struct npt_renderer_shmem **slots =
+         realloc(aux->external_slots, cap * sizeof(*slots));
+      if (!slots)
+         return false;
+      aux->external_slots = slots;
+      aux->external_cap = cap;
+   }
+
+   struct npt_renderer *renderer = aux->com->base.device->renderer;
+   struct npt_renderer_shmem *shmem =
+      npt_renderer_shmem_create(renderer, aux->byte_width);
+   if (!shmem)
+      return false;
+
+   /* Blob creation uses the KMD/context path; make the resource-table
+    * insert visible before the method ring names this res_id. */
+   npt_ring_force_roundtrip(ring);
+
