diff --git a/src/virtio/neptune/npt_ring_watchdog.h b/src/virtio/neptune/npt_ring_watchdog.h
new file mode 100644
index 00000000000..c7e2b9d4d62
--- /dev/null
+++ b/src/virtio/neptune/npt_ring_watchdog.h
@@ -0,0 +1,57 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * Host heartbeat watchdog for a ring, shared by every thread that waits
+ * on it.  Staleness is judged by wall time since the counter last moved,
+ * so concurrent waiters cannot add up to a false "host gone".
+ */
+
+#ifndef NPT_RING_WATCHDOG_H
+#define NPT_RING_WATCHDOG_H
+
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The heartbeat is the ring status word above its low 8 flag bits. */
+#define NPT_RING_WATCHDOG_BEAT_BITS 24
+
+/* (ms when the current heartbeat value was first seen << 24) | heartbeat.
+ * One word, so a waiter never pairs one value with another's timestamp.
+ * Zero means nothing has been observed yet. */
+typedef _Atomic uint64_t npt_ring_watchdog;
+
+/*
+ * Record that the heartbeat reads `beat` at `now_ms` (nonzero, monotonic).
+ * Returns true when it has stood still for at least `stale_ms`; exactly one
+ * of the concurrent callers gets true, and the window restarts there.
+ */
+static inline bool
+npt_ring_watchdog_expired(npt_ring_watchdog *w, uint32_t beat,
+                          uint64_t now_ms, uint64_t stale_ms)
+{
+   const uint64_t beat_mask = (1ull << NPT_RING_WATCHDOG_BEAT_BITS) - 1;
+   const uint64_t observed =
+      (now_ms << NPT_RING_WATCHDOG_BEAT_BITS) | (beat & beat_mask);
+   uint64_t seen = atomic_load_explicit(w, memory_order_relaxed);
+   const uint64_t seen_ms = seen >> NPT_RING_WATCHDOG_BEAT_BITS;
+
+   if (!seen_ms || (seen & beat_mask) != (beat & beat_mask)) {
+      /* First observation, or the counter moved: restart the window.  A
+       * lost race means another waiter just did the same. */
+      atomic_compare_exchange_strong_explicit(w, &seen, observed,
+                                              memory_order_relaxed,
+                                              memory_order_relaxed);
+      return false;
+   }
+
+   if (now_ms <= seen_ms || now_ms - seen_ms < stale_ms)
+      return false;
+
+   return atomic_compare_exchange_strong_explicit(w, &seen, observed,
+                                                  memory_order_relaxed,
+                                                  memory_order_relaxed);
+}
+
+#endif /* NPT_RING_WATCHDOG_H */
diff --git a/src/virtio/neptune/npt_ring_watchdog_test.c b/src/virtio/neptune/npt_ring_watchdog_test.c
new file mode 100644
index 00000000000..06ad768a6b5
--- /dev/null
+++ b/src/virtio/neptune/npt_ring_watchdog_test.c
@@ -0,0 +1,78 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "npt_ring_watchdog.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define PERIOD_MS 3000u
+#define STALE_MS  (9u * PERIOD_MS)
+#define WAITERS   6
+#define CHECKS    64
+
+#define EXPECT(cond)                                                   \
+   do {                                                                \
+      if (!(cond)) {                                                   \
+         fprintf(stderr, "%s:%d: expected %s\n", __FILE__, __LINE__, #cond); \
+         exit(1);                                                      \
+      }                                                                \
+   } while (0)
+
+static npt_ring_watchdog shared;
+static _Atomic unsigned expirations;
+
+/* Every waiter checks a live host many times within one heartbeat
+ * period; a shared miss counter declared the host dead after three. */
+static void *
+waiter(void *arg)
+{
+   const uint64_t start = (uint64_t)(uintptr_t)arg;
+   for (unsigned i = 0; i < CHECKS; i++) {
+      const uint64_t now = start + (uint64_t)i * (PERIOD_MS - 1) / CHECKS;
+      if (npt_ring_watchdog_expired(&shared, 11, now, STALE_MS))
+         atomic_fetch_add(&expirations, 1);
+   }
+   return NULL;
+}
+
+int
+main(void)
+{
+   pthread_t threads[WAITERS];
+   for (unsigned i = 0; i < WAITERS; i++)
+      pthread_create(&threads[i], NULL, waiter, (void *)(uintptr_t)1000);
+   for (unsigned i = 0; i < WAITERS; i++)
+      pthread_join(threads[i], NULL);
+   EXPECT(atomic_load(&expirations) == 0);
+
+   /* A ticking heartbeat never expires, however long the wait. */
+   npt_ring_watchdog w = 0;
+   for (uint64_t t = 1, beat = 1; t < 10 * STALE_MS; t += PERIOD_MS, beat++)
+      EXPECT(!npt_ring_watchdog_expired(&w, (uint32_t)beat, t, STALE_MS));
+
+   /* A stopped heartbeat expires once after STALE_MS, then the window
+    * restarts. */
+   w = 0;
+   EXPECT(!npt_ring_watchdog_expired(&w, 5, 100, STALE_MS));
+   EXPECT(!npt_ring_watchdog_expired(&w, 5, 100 + STALE_MS - 1, STALE_MS));
+   EXPECT(npt_ring_watchdog_expired(&w, 5, 100 + STALE_MS, STALE_MS));
+   EXPECT(!npt_ring_watchdog_expired(&w, 5, 100 + STALE_MS + 1, STALE_MS));
+   EXPECT(npt_ring_watchdog_expired(&w, 5, 100 + 2 * STALE_MS, STALE_MS));
+
+   /* A counter stuck at 0 (CREATE_RING never serviced) expires too. */
+   w = 0;
+   EXPECT(!npt_ring_watchdog_expired(&w, 0, 1, STALE_MS));
+   EXPECT(npt_ring_watchdog_expired(&w, 0, 1 + STALE_MS, STALE_MS));
+
+   /* Only the low 24 bits are the heartbeat. */
+   w = 0;
+   EXPECT(!npt_ring_watchdog_expired(&w, 7 | (1u << 24), 1, STALE_MS));
+   EXPECT(npt_ring_watchdog_expired(&w, 7, 1 + STALE_MS, STALE_MS));
+
+   printf("npt_ring_watchdog: ok\n");
+   return 0;
+}
