diff --git a/tests/d3d12_empty_cs_test.cpp b/tests/d3d12_empty_cs_test.cpp
new file mode 100644
index 0000000..1c0379f
--- /dev/null
+++ b/tests/d3d12_empty_cs_test.cpp
@@ -0,0 +1,74 @@
+/*
+ * Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * A compute pipeline whose CS is empty is refused with E_INVALIDARG rather
+ * than created.  D3DMetal does not check it: its stage cache looks the empty
+ * bytecode up, gets NULL back and dereferences it, killing the process.
+ *
+ * Prints "EMPTYCS: PASS" and exits 0 on success.
+ */
+
+#include <cstdio>
+
+#include <d3d12.h>
+#include <windows.h>
+
+#include "d3dmetal_native.h"
+
+#define T_TAG "EMPTYCS"
+#include "common/check.h"
+
+namespace {
+
+int run() {
+    if (dmn_init(nullptr) != DMN_SUCCESS) {
+        fprintf(stderr, T_TAG ": dmn_init FAILED\n");
+        return 1;
+    }
+
+    ID3D12Device* dev = nullptr;
+    CK(D3D12CreateDevice(nullptr, D3D_FEATURE_LEVEL_11_0,
+                         __uuidof(ID3D12Device), (void**)&dev),
+       "D3D12CreateDevice");
+
+    D3D12_ROOT_SIGNATURE_DESC rd = {};
+    ID3DBlob* blob = nullptr;
+    ID3DBlob* err = nullptr;
+    CK(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &blob,
+                                   &err),
+       "D3D12SerializeRootSignature");
+    ID3D12RootSignature* rs = nullptr;
+    CK(dev->CreateRootSignature(0, blob->GetBufferPointer(),
+                                blob->GetBufferSize(),
+                                __uuidof(ID3D12RootSignature), (void**)&rs),
+       "CreateRootSignature");
+    blob->Release();
+
+    static const unsigned char kByte = 0;
+    const D3D12_SHADER_BYTECODE empties[] = {{nullptr, 0}, {&kByte, 0}};
+    for (const D3D12_SHADER_BYTECODE& cs : empties) {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC cd = {};
+        cd.pRootSignature = rs;
+        cd.CS = cs;
+        ID3D12PipelineState* pso = nullptr;
+        HRESULT hr = dev->CreateComputePipelineState(
+            &cd, __uuidof(ID3D12PipelineState), (void**)&pso);
+        printf(T_TAG ": CS {%p, 0} -> 0x%08x\n", cs.pShaderBytecode,
+               (unsigned)hr);
+        EXPECT(hr == E_INVALIDARG, "an empty CS was not refused");
+        EXPECT(!pso, "a refused create returned a pipeline");
+    }
+
+    rs->Release();
+    dev->Release();
+    T_PASS();
+    return 0;
+}
+
+} // namespace
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    return run();
+}
