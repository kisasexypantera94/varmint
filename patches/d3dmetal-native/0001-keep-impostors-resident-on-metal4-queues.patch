 }
+
+/* == Metal 4 queues (macOS 26) ==========================================
+ * With Metal 4 on, D3DMetal executes command lists on an MTL4CommandQueue
+ * whose command buffers come from the device, so the classic queue,
+ * command-buffer and encoder hooks above never see that work. The queue
+ * still needs the impostor set: D3DMetal's own set drops a buffer when any
+ * D3D12 resource using it dies, and an alias-cache impostor is shared by
+ * every placement at its offset, so the survivors read zeros once Metal
+ * evicts the pages. Commits join the in-flight barrier and drive the sweep,
+ * as encoder creation does on classic queues. Metal 4 has no useResources:,
+ * so the per-command-buffer path (sparse textures, DMN_RESIDENCY_SET=0) does
+ * not cover these queues. */
+API_AVAILABLE(macos(26.0))
+void swz_q4_commit_opts(id self, SEL _cmd,
+                        const id<MTL4CommandBuffer>* cbs,
+                        NSUInteger count, MTL4CommitOptions* opts) {
+    IMP orig = lookup_orig(object_getClass(self), _cmd);
+    if (!orig)
+        return;
+    residency_mtl4_committed(opts);
+    ((void (*)(id, SEL, const id<MTL4CommandBuffer>*,
+               NSUInteger, MTL4CommitOptions*))orig)(self, _cmd, cbs, count,
+                                                      opts);
+
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (g_res_mode.load(std::memory_order_relaxed) != 1 ||
+        now < g_next_tick_ns.load(std::memory_order_acquire))
+        return;
+    std::lock_guard<std::mutex> lk(g_sub_lock);
+    g_next_tick_ns.store(now + kTickNs, std::memory_order_release);
+    residency_sweep_locked(now);
+}
+
+/* No options to carry the feedback handler: commit through the variant that
+ * has them. */
+API_AVAILABLE(macos(26.0))
+void swz_q4_commit(id self, SEL _cmd,
+                   const id<MTL4CommandBuffer>* cbs,
+                   NSUInteger count) {
+    (void)_cmd;
+    MTL4CommitOptions* opts = [[MTL4CommitOptions alloc] init];
+    [(id<MTL4CommandQueue>)self commit:cbs count:count options:opts];
+    [opts release];
+}
+
+API_AVAILABLE(macos(26.0))
+void note_new_mtl4_queue(id q) {
+    if (!q)
+        return;
+    static const SwizzleJob jobs[] = {
+        { @selector(commit:count:options:), (IMP)swz_q4_commit_opts },
+        { @selector(commit:count:), (IMP)swz_q4_commit },
+    };
+    static std::atomic<Class> memo{nullptr};
+    install_swizzles(object_getClass(q), jobs, sizeof(jobs) / sizeof(jobs[0]),
+                     "metal4-commit", &memo);
+    residency_attach_queue(q, /*late=*/false);
+}
+
+API_AVAILABLE(macos(26.0))
+id swz_dev_newq4(id self, SEL _cmd) {
+    IMP orig = lookup_orig(object_getClass(self), _cmd);
+    id q = orig ? ((id (*)(id, SEL))orig)(self, _cmd) : nil;
+    note_new_mtl4_queue(q);
+    return q;
+}
+
+API_AVAILABLE(macos(26.0))
+id swz_dev_newq4desc(id self, SEL _cmd, id desc, NSError** err) {
+    IMP orig = lookup_orig(object_getClass(self), _cmd);
+    id q = orig ? ((id (*)(id, SEL, id, NSError**))orig)(self, _cmd, desc, err)
+                : nil;
+    note_new_mtl4_queue(q);
+    return q;
+}
