+/* The same for a Metal 4 commit. Its command buffers have no completion
+ * handler; the commit's feedback handler runs once all of them have finished.
+ * Options keep every handler added to them, so this assumes fresh options per
+ * commit, which is what D3DMetal passes. */
+API_AVAILABLE(macos(26.0))
+void residency_mtl4_committed(MTL4CommitOptions* opts) {
+    if (g_res_mode.load(std::memory_order_relaxed) != 1)
+        return;
+    uint64_t seq;
+    {
+        std::lock_guard<std::mutex> lk(g_cb_mtx);
+        seq = ++g_cb_seq;
+        g_cb_inflight.insert(seq);
+    }
+    [opts addFeedbackHandler:^(id<MTL4CommitFeedback> unused) {
+        (void)unused;
+        std::lock_guard<std::mutex> lk(g_cb_mtx);
+        g_cb_inflight.erase(seq);
+    }];
+}
