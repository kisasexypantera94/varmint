#!/bin/sh
set -eu

STATE_DIR=/var/lib/varmint
USER_FILE=$STATE_DIR/firstboot.user
DONE_FILE=$STATE_DIR/firstboot.done

cleanup() {
    stty echo 2>/dev/null || true
    [ -z "${partial:-}" ] || rm -f "$partial" || true
}
trap cleanup EXIT HUP INT TERM

load_user() {
    [ -s "$USER_FILE" ] || return 1
    username=$(cat "$USER_FILE")
    entry=$(getent passwd "$username") || {
        printf 'Saved Varmint user %s no longer exists.\n' "$username" >&2
        exit 1
    }
    home_dir=$(printf '%s\n' "$entry" | cut -d: -f6)
}

save_user() {
    printf '%s\n' "$username" > "$USER_FILE"
    chmod 0600 "$USER_FILE"
    load_user
}

create_user() {
    install -d -m 0755 "$STATE_DIR"
    load_user && return

    if [ -f /home/.varmint/user-v1 ]; then
        /usr/local/libexec/varmint-user-state restore
        load_user || {
            printf '%s\n' 'Persistent Varmint user restore did not create firstboot.user.' >&2
            exit 1
        }
        return
    fi

    username=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd)
    if [ -n "$username" ]; then
        save_user
        return
    fi

    while :; do
        printf 'Username: '
        IFS= read -r username
        case "$username" in
            root|'')
                printf 'Choose a non-root username.\n'
                ;;
            *[!a-z0-9_-]*|[0-9-]*)
                printf 'Use lowercase letters, digits, underscore or dash; start with a letter or underscore.\n'
                ;;
            *)
                getent passwd "$username" >/dev/null \
                    && printf 'That user already exists.\n' \
                    || break
                ;;
        esac
    done

    while :; do
        printf 'Password: '
        stty -echo
        IFS= read -r password
        stty echo
        printf '\nRepeat password: '
        stty -echo
        IFS= read -r confirmation
        stty echo
        printf '\n'

        if [ -z "$password" ]; then
            printf 'Password cannot be empty.\n'
        elif [ "$password" != "$confirmation" ]; then
            printf 'Passwords do not match.\n'
        else
            break
        fi
    done

    useradd --create-home --shell /bin/bash "$username"
    printf '%s:%s\n' "$username" "$password" | chpasswd
    unset password confirmation

    for group in sudo audio video render input; do
        getent group "$group" >/dev/null && usermod -aG "$group" "$username"
    done
    save_user
}

run_as_user() {
    sudo -H -u "$username" env -i \
        HOME="$home_dir" \
        USER="$username" \
        LOGNAME="$username" \
        PATH=/usr/local/bin:/usr/bin:/bin \
        XDG_CONFIG_HOME="$home_dir/.config" \
        XDG_DATA_HOME="$home_dir/.local/share" \
        XDG_CACHE_HOME="$home_dir/.cache" \
        "$@"
}

setup_desktop() {
    ui_scale=1

    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            varmint.ui_scale=1) ui_scale=1 ;;
            varmint.ui_scale=2) ui_scale=2 ;;
        esac
    done

    install -d -m 0755 /etc/varmint
    printf '%s\n' "$ui_scale" > /etc/varmint/ui-scale
    chmod 0644 /etc/varmint/ui-scale

    # Varmint is a single-user appliance-style VM. Keep the account password
    # for sudo/SSH, but enter the Plasma Wayland desktop automatically.
    session=
    for candidate in \
        /usr/share/wayland-sessions/plasma.desktop \
        /usr/share/wayland-sessions/plasmawayland.desktop
    do
        if [ -f "$candidate" ]; then
            session=$(basename "$candidate")
            break
        fi
    done

    [ -n "$session" ] || {
        printf '%s\n' 'Plasma Wayland session file is missing.' >&2
        exit 1
    }

    install -d -m 0755 /etc/sddm.conf.d
    cat > /etc/sddm.conf.d/10-varmint-autologin.conf <<EOF_SDDM
[Autologin]
User=$username
Session=$session
Relogin=true
EOF_SDDM
}

install_steam() {
    steam_root=$home_dir/.local/share/Steam
    bootstrap=/usr/local/share/varmint/steam-bootstrap
    client=$steam_root/steamrtarm64/steam

    [ -x "$bootstrap/steamrtarm64/steam" ] || {
        printf '%s\n' 'ARM64 Steam bootstrap is missing from the Varmint image.' >&2
        exit 1
    }

    if [ ! -x "$client" ]; then
        printf '\nInstalling the ARM64 Steam bootstrap...\n'

        run_as_user mkdir -p "$steam_root"
        run_as_user cp -a "$bootstrap/." "$steam_root/"
    fi

    run_as_user mkdir -p \
        "$steam_root/package" \
        "$home_dir/.steam"

    run_as_user ln -sfn steamrtarm64 "$steam_root/steamrt64"
    run_as_user touch "$steam_root/.steam-enable-steamrt64-client"
    run_as_user sh -c \
        'printf "%s\n" publicbeta > "$1/package/beta"' \
        sh "$steam_root"

    run_as_user ln -sTfn "$steam_root" "$home_dir/.steam/steam"
    run_as_user ln -sTfn "$steam_root" "$home_dir/.steam/root"

    # Steam's ARM client launches games through the native ARM64 wrapper, while
    # Proton itself runs as x86_64 under FEX. lsteamclient therefore expects
    # both standard Steam SDK paths to exist.
    run_as_user ln -sfn "$home_dir/.local/share/Steam/linuxarm64" "$home_dir/.steam/sdkarm64"
    run_as_user ln -sfn "$home_dir/.local/share/Steam/linux64" "$home_dir/.steam/sdk64"
    run_as_user ln -sfn "$home_dir/.local/share/Steam/linux32" "$home_dir/.steam/sdk32"

    [ -x "$client" ] || {
        printf '%s\n' 'ARM64 Steam bootstrap installation failed.' >&2
        exit 1
    }
}

verify_setup() {
    [ -f /usr/share/guestos/fex-mesa/graphics_provider.json ] || {
        printf '%s\n' 'Varmint FEX rootfs is missing graphics_provider.json.' >&2
        exit 1
    }

    [ -x "$home_dir/.local/share/Steam/steamrtarm64/steam" ] || {
        printf '%s\n' 'ARM64 Steam bootstrap verification failed.' >&2
        exit 1
    }
}

main() {
    printf '%s\n\n' 'Varmint first boot'
    create_user
    /usr/local/libexec/varmint-user-state save "$username"

    passwd -l root >/dev/null 2>&1 || true

    printf '\nPreparing the gaming environment. This may take a few minutes...\n'
    setup_desktop
    install_steam
    verify_setup

    systemctl unmask sddm.service >/dev/null 2>&1 || true
    systemctl enable sddm.service >/dev/null
    systemctl set-default graphical.target >/dev/null
    systemctl start sddm.service

    touch "$DONE_FILE"
    printf '\nVarmint is ready for %s.\n' "$username"
}

main "$@"
