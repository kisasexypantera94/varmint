#!/usr/bin/env python3
import os
import select
import shutil
import struct
import subprocess
import sys
import time
from pathlib import Path

POLL_INTERVAL = 0.25
RETRY_INTERVAL = 1.0
MAX_FRAME = 16 * 1024 * 1024


def log(message):
    print(f"varmint-clipboard-agent: {message}", file=sys.stderr, flush=True)


def find_port():
    named = Path("/dev/virtio-ports/clipboard")
    if named.exists():
        return named

    for entry in Path("/sys/class/virtio-ports").glob("vport*p*"):
        try:
            if (entry / "name").read_text(encoding="utf-8").strip() == "clipboard":
                return Path("/dev") / entry.name
        except OSError:
            continue

    raise FileNotFoundError("clipboard virtio-console port is not available")


class Clipboard:
    def __init__(self):
        if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy") and shutil.which("wl-paste"):
            self.backend = "wayland"
        elif os.environ.get("DISPLAY") and shutil.which("xclip"):
            self.backend = "xclip"
        elif os.environ.get("DISPLAY") and shutil.which("xsel"):
            self.backend = "xsel"
        else:
            raise RuntimeError("no supported graphical clipboard backend is available")

    def read(self):
        if self.backend == "wayland":
            command = ["wl-paste", "--no-newline"]
        elif self.backend == "xclip":
            command = ["xclip", "-selection", "clipboard", "-out"]
        else:
            command = ["xsel", "--clipboard", "--output"]

        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
        return result.stdout if result.returncode == 0 else None

    def write(self, payload):
        if self.backend == "wayland":
            command = ["wl-copy", "--type", "text/plain;charset=utf-8"]
        elif self.backend == "xclip":
            command = ["xclip", "-selection", "clipboard", "-in"]
        else:
            command = ["xsel", "--clipboard", "--input"]

        subprocess.run(command, input=payload, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)


def write_all(fd, payload):
    offset = 0
    while offset < len(payload):
        try:
            offset += os.write(fd, payload[offset:])
        except BlockingIOError:
            select.select([], [fd], [])


def run_session():
    clipboard = Clipboard()
    port = find_port()
    fd = os.open(port, os.O_RDWR | os.O_NONBLOCK)
    rx = bytearray()
    last = clipboard.read()

    log(f"using {port} with {clipboard.backend}")

    try:
        while True:
            readable, _, _ = select.select([fd], [], [], POLL_INTERVAL)
            if readable:
                chunk = os.read(fd, 65536)
                if not chunk:
                    raise OSError("clipboard port closed")
                rx.extend(chunk)

                while len(rx) >= 4:
                    size = struct.unpack_from("<I", rx)[0]
                    if size > MAX_FRAME:
                        raise ValueError(f"clipboard frame is too large: {size}")
                    if len(rx) < 4 + size:
                        break

                    payload = bytes(rx[4:4 + size])
                    del rx[:4 + size]
                    if payload != last:
                        clipboard.write(payload)
                        last = payload

            payload = clipboard.read()
            if payload is not None and payload != last:
                if len(payload) > MAX_FRAME:
                    log(f"clipboard contents are too large: {len(payload)}")
                    last = payload
                    continue
                write_all(fd, struct.pack("<I", len(payload)) + payload)
                last = payload
    finally:
        os.close(fd)


def main():
    while True:
        try:
            run_session()
        except Exception as error:
            log(str(error))
            time.sleep(RETRY_INTERVAL)


if __name__ == "__main__":
    main()
