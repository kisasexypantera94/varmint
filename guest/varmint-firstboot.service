[Unit]
Description=Set up Varmint
Requires=varmint-grow-root.service varmint-home.service
Wants=varmint-host-time.service
After=systemd-user-sessions.service varmint-grow-root.service varmint-home.service varmint-host-time.service
Before=getty@tty1.service
ConditionPathExists=!/var/lib/varmint/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/varmint-firstboot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
