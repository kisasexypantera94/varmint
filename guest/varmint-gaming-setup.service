[Unit]
Description=Prepare the Varmint gaming environment
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target systemd-time-wait-sync.service varmint-firstboot.service
ConditionPathExists=/var/lib/varmint/firstboot.done
ConditionPathExists=!/var/lib/varmint/gaming-setup.done

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/varmint-firstboot gaming
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
