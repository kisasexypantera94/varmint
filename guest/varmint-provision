#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

cat > /etc/apt/apt.conf.d/80-varmint-retries <<'EOF_APT'
Acquire::Retries "3";
EOF_APT

cat > /etc/apt/sources.list.d/varmint-backports.sources <<'EOF_BACKPORTS'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF_BACKPORTS

apt-get update
apt-get install -y --no-install-recommends \
    adwaita-icon-theme \
    ca-certificates \
    cloud-guest-utils \
    curl \
    dbus-user-session \
    dolphin \
    konsole \
    kwin-wayland \
    kscreen \
    plasma-desktop \
    plasma-pa \
    plasma-workspace \
    sddm \
    systemsettings \
    wl-clipboard \
    xwayland \
    e2fsprogs \
    fonts-dejavu-core \
    fonts-liberation \
    gdisk \
    librsvg2-common \
    locales \
    lsof \
    libasound2-plugins \
    libasound2t64 \
    libdrm2 \
    libegl1 \
    libfmt10 \
    libgl1 \
    libgtk2.0-0 \
    libopenal1 \
    libssl3t64 \
    libstdc++6 \
    libvulkan1 \
    libwayland-client0 \
    libnm0 \
    libnotify-bin \
    libx11-6 \
    libxi6 \
    libxcb1 \
    libxrandr2 \
    libxrender1 \
    libxxhash0 \
    mesa-utils \
    openssh-server \
    avahi-daemon \
    pavucontrol \
    pulseaudio \
    pulseaudio-utils \
    python3 \
    rtkit \
    squashfs-tools \
    sudo \
    systemd-timesyncd \
    unzip \
    vulkan-tools \
    x11-xserver-utils \
    xclip \
    xdg-user-dirs \
    xserver-xorg \
    xserver-xorg-input-libinput

apt-get install -y --no-install-recommends -t trixie-backports \
    libegl-mesa0 \
    libgbm1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    mesa-vulkan-drivers

# Varmint uses PulseAudio directly for virtio-snd. Plasma installation may
# pull parts of PipeWire back in, so enforce the final audio stack only after
# all desktop packages have been installed.
apt-get purge -y \
    pipewire \
    pipewire-alsa \
    pipewire-audio \
    pipewire-pulse \
    wireplumber

# Steam and several games expect this locale to exist.
sed -i 's/^# *\(en_US.UTF-8 UTF-8\)$/\1/' /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# The stock cloud initramfs may not contain fsck even though e2fsprogs is
# installed in the root filesystem. Rebuild it with the Varmint hook so a
# dirty ext4 root is repaired before it is mounted and grown online.
command -v fsck >/dev/null 2>&1
command -v e2fsck >/dev/null 2>&1
command -v update-initramfs >/dev/null 2>&1
update-initramfs -u -k all

# Keep PulseAudio's udev-managed ALSA card lifecycle, but disable timer-based
# scheduling for virtio-snd and use a fixed 4 x 10 ms playback buffer.
sed -i \
    's|^[[:space:]]*load-module[[:space:]]\+module-udev-detect.*$|load-module module-udev-detect tsched=0|' \
    /etc/pulse/default.pa

sed -i \
    -e 's|^[;[:space:]]*default-fragments[[:space:]]*=.*$|default-fragments = 4|' \
    -e 's|^[;[:space:]]*default-fragment-size-msec[[:space:]]*=.*$|default-fragment-size-msec = 10|' \
    /etc/pulse/daemon.conf

# The user PulseAudio service can otherwise start before the virtio-snd ALSA
# card is present and remain attached to auto_null until manually restarted.
install -d -m 0755 /etc/systemd/user/pulseaudio.service.d
cat > /etc/systemd/user/pulseaudio.service.d/varmint-audio.conf <<'EOF_PULSE_SYSTEMD'
[Service]
ExecStartPre=/bin/sh -c 'i=0; while [ ! -e /dev/snd/controlC0 ]; do i=$((i + 1)); [ "$i" -ge 100 ] && exit 1; sleep 0.1; done'
EOF_PULSE_SYSTEMD

grep -Fx \
    'load-module module-udev-detect tsched=0' \
    /etc/pulse/default.pa >/dev/null
grep -Fx 'default-fragments = 4' /etc/pulse/daemon.conf >/dev/null
grep -Fx 'default-fragment-size-msec = 10' /etc/pulse/daemon.conf >/dev/null

install -d -m 0755 /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/20-varmint-cursor.conf <<'EOF_XORG'
Section "Device"
    Identifier "Varmint GPU"
    Driver "modesetting"
    Option "SWCursor" "true"
EndSection
EOF_XORG

# Stable entry point used by the desktop file and Steam-created shortcuts.
ln -sfn /usr/local/bin/varmint-steam /usr/bin/steam

install -m 0755 /usr/local/share/varmint/varmint-display-scale /usr/local/bin/varmint-display-scale
install -d -m 0755 /etc/xdg/autostart
install -m 0644 /usr/local/share/varmint/varmint-display-scale.desktop /etc/xdg/autostart/varmint-display-scale.desktop

python3 - <<'PY_TASKMANAGER'
from pathlib import Path

p = Path("/usr/share/plasma/plasmoids/org.kde.plasma.taskmanager/contents/config/main.xml")
s = p.read_text()

old = "<default>applications:systemsettings.desktop,applications:org.kde.discover.desktop,preferred://filemanager,preferred://browser</default>"
new = "<default>preferred://filemanager,applications:steam.desktop</default>"

if old not in s:
    raise SystemExit("Plasma task manager default launcher list not found")

p.write_text(s.replace(old, new, 1))
PY_TASKMANAGER

install -d -m 0755 /etc/environment.d
cat > /etc/environment.d/90-varmint-kwin.conf <<'EOF_KWIN_ENV'
KWIN_FORCE_SW_CURSOR=1
EOF_KWIN_ENV

install -d -m 0755 /etc/sysctl.d
cat > /etc/sysctl.d/60-varmint-gaming.conf <<'EOF_SYSCTL'
vm.overcommit_memory = 1
EOF_SYSCTL

install -d -m 0755 /etc/udev/rules.d
cat > /etc/udev/rules.d/70-varmint-clipboard.rules <<'EOF_UDEV'
SUBSYSTEM=="virtio-ports", ATTR{name}=="clipboard", MODE="0660", TAG+="uaccess"
EOF_UDEV

# Host keys are deliberately removed from the published image so cloned VMs do
# not share an SSH identity. Generate them immediately before sshd validates its
# configuration, independently of the interactive first-boot provisioning.
install -d -m 0755 /etc/systemd/system/ssh.service.d
cat > /etc/systemd/system/ssh.service.d/varmint-hostkeys.conf <<'EOF_SSH'
[Service]
ExecStartPre=
ExecStartPre=/usr/bin/ssh-keygen -A
ExecStartPre=/usr/sbin/sshd -t
EOF_SSH

systemctl enable openssh-server.service >/dev/null 2>&1 || true
systemctl enable avahi-daemon.service >/dev/null 2>&1 || true
# Guest-side suspend is intentionally disabled. Varmint's VM lifecycle is
# controlled by the macOS host; a Plasma idle suspend leaves the virtual
# machine in s2idle with no reliable host wake path.
systemctl mask \
    sleep.target \
    suspend.target \
    hibernate.target \
    hybrid-sleep.target \
    suspend-then-hibernate.target \
    >/dev/null 2>&1 || true

systemctl enable systemd-timesyncd.service >/dev/null 2>&1 || true
systemctl --global enable varmint-audio-watchdog.service >/dev/null 2>&1 || true
systemctl disable sddm.service >/dev/null 2>&1 || true
systemctl set-default multi-user.target

apt-get clean
rm -rf /var/lib/apt/lists/*
