/dts-v1/;

/ {
	compatible = "varmint,virt";
	#address-cells = <2>;
	#size-cells = <2>;
	
	aliases {
		serial0 = &uart0;
	};
	
	chosen {
		bootargs = "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000";
		stdout-path = "serial0:115200n8";
		
		linux,initrd-start = <0x0 0x48000000>;
		linux,initrd-end   = <0x0 0x4a800000>;
	};
	
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x0>;
		};
	};
	
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x20000000>;
	};
	
	clk24m: clk24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
	
	uart0: serial@9000000 {
		compatible = "arm,pl011", "arm,primecell";
		reg = <0x0 0x09000000 0x0 0x1000>;
		clocks = <&clk24m &clk24m>;
		clock-names = "uartclk", "apb_pclk";
		status = "okay";
	};
};